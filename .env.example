FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-secure-random-string
DATABASE_URL=sqlite:///launch_spots.db
# Optional: set to 1 to enable external Royal Navy lookup (disabled by default)
ENABLE_ROYAL_NAVY_LOOKUP=0
# Example: set to production host/port for gunicorn deployment
GUNICORN_WORKERS=2
